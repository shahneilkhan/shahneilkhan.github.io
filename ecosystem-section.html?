  .snk-eco-premium .eco-live::before{
    content:""; width:6px; height:6px; border-radius:50%; background:#4ade80; box-shadow:0 0 6px #4ade80;
  }

  .snk-eco-premium .eco-category{
    font-size:11px; letter-spacing:1.5px; text-transform:uppercase; color:var(--eco-teal); font-weight:700;
  }
  .snk-eco-premium .eco-card h3{ font-size:19px; font-weight:700; }
  .snk-eco-premium .eco-card p{ font-size:13.5px; color:var(--eco-muted); line-height:1.65; flex:1; }
  .snk-eco-premium .eco-visit{
